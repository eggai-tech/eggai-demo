{
  "ai": {
    "reviewStage": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "inputPerMillion": 3.0,
      "outputPerMillion": 15.0,
      "temperature": 0
    }
  },
  "review": {
    "minConfidence": 7,
    "pipeline": [
      {
        "name": "agenticReview",
        "enabled": true,
        "mode": "agentic",
        "agentic": {
          "maxTurns": 15,
          "maxBudgetUsd": 3.0,
          "contextMode": "auto",
          "maxTokensPerFile": 8000,
          "maxTotalTokens": 50000,
          "enabledSubagents": [
            "security-analyzer",
            "dependency-tracer",
            "pattern-validator"
          ]
        }
      }
    ]
  },
  "github": {
    "postComments": true,
    "maxInlineComments": 50
  }
}
